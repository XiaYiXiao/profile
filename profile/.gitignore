# Publish only reusable scripts and documentation from the approved locations.
# Results, traces, backups, installation snapshots and caches stay local.
*
!/.gitignore
!/*.md
!/*.py
!/*.sh

!/decode/
!/decode/*.md
!/decode/*.py
!/decode/*.sh
!/decode/analysis/
!/decode/analysis/batch-diagnosis-20261108/
!/decode/analysis/batch-diagnosis-20261108/*.py
!/decode/kv-capacity-validation-20261108/
!/decode/kv-capacity-validation-20261108/*.py
!/decode/kv-capacity-validation-20261108/hooks/
!/decode/kv-capacity-validation-20261108/hooks/*.py

!/ep_profile/
!/ep_profile/README.md
!/ep_profile/*.sh
!/ep_profile/analysis/
!/ep_profile/analysis/code/
!/ep_profile/analysis/code/*.py
!/ep_profile/backends/
!/ep_profile/backends/*.md

# These one-off scripts require specific historical result directories.
/ep_profile/analysis/code/compare_batches.py
/ep_profile/analysis/code/compare_eplb_warmups.py

# Defensive exclusions for future files in the source directories.
**/__pycache__/
*.py[cod]
.env
.env.*
*.log
*.sqlite*
*.nsys-rep
*.qdrep
*.ncu-rep
*.csv
*.svg
*.png
*.tar*
*.zip
*.gz
